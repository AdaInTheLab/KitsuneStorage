<configs>

	<!-- The loot window's slot pool must cover the biggest container it can display. -->
	<!-- Vanilla is 10x9 = 90 cells; the 12x12 steel crate needs 144, so 16x12 = 192. -->
	<!-- V3.3 moved the grid inside a scrollview (content/scrollview/grid), so the path -->
	<!-- uses // to match the grid at either depth and keep working on V3.0 to V3.3. -->
	<!-- Rows only ever go UP: KitsuneBackpack200 needs a 228-cell pool for its death bag and -->
	<!-- loads before this mod, so an unconditional set here would shrink it back to 192. -->
	<!-- Both mods use 12 columns, so the larger rows value always wins. -->
	<set xpath="/windows/window[@name='windowLooting']//grid[@name='queue'][@rows &lt; 16]/@rows">16</set>
	<set xpath="/windows/window[@name='windowLooting']//grid[@name='queue']/@cols">12</set>

</configs>
